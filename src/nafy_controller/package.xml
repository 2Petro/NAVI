<?xml version="1.0"?>
<package format="3">
  <name>nafy_controller</name>
  <version>0.1.0</version>
  <description>Nafy dispatch controller - Optimized API for hospital office navigation.</description>
  <maintainer email="nafy@hospital.local">Nafy Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nafy_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
